# Copy to .env for local dev. On Vercel, add these in Project Settings -> Environment Variables.

# Claude (required for live dialogue). Without it the house runs in offline mode with canned lines.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model. Default is claude-opus-5-5. Cheaper option: claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# fal.ai (required for logo generation). Without it the coin gets a placeholder logo.
FAL_KEY=...
# Optional: fal model id. Default is fal-ai/flux/schnell
FAL_MODEL=fal-ai/flux/schnell

# Optional: set to "1" to pause all AI calls (e.g. to cap spending) without redeploying.
AI_PAUSED=0
