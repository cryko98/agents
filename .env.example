# Copy to .env for local dev. On Vercel, add these in Project Settings -> Environment Variables.
# `vercel env pull .env.local` fetches what is already set on Vercel (Upstash credentials included).

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...          # required for real dialogue; without it: canned lines
ANTHROPIC_MODEL=claude-opus-5-5       # optional; cheaper: claude-haiku-5-5
ANTHROPIC_DESK_MODEL=                 # optional; model for the trading desk (defaults to ANTHROPIC_MODEL)
FAL_KEY=                              # required for logo / artwork images
FAL_MODEL=fal-ai/flux/schnell

# --- shared world (set automatically by the Upstash integration on Vercel) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- wallet & trading ---
TRADING_MODE=paper                    # paper | live
PAPER_START_SOL=2                     # virtual starting balance in paper mode
AGENT_WALLET_PUBLIC=                  # public address shown on the site (donations); node scripts/wallet.mjs
AGENT_WALLET_SECRET=                  # base58 secret key. LIVE MODE ONLY. never commit.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # a Helius/QuickNode RPC is more reliable
JUPITER_API_KEY=                      # optional, raises Jupiter rate limits
# guardrails (defaults shown)
MAX_TRADE_FRACTION=0.10
MIN_TRADE_SOL=0.02
MAX_TRADES_PER_DAY=3
MAX_OPEN_POSITIONS=4
DAILY_DRAWDOWN_STOP=0.20
MIN_LIQUIDITY_USD=100000
MIN_TOKEN_AGE_H=24
MIN_ORGANIC_SCORE=30
RESERVE_SOL=0.05
DESK_INTERVAL_MS=900000               # trading desk every 15 minutes

# --- launching the house coin on pump.fun (live only) ---
LAUNCH_ENABLED=0                      # 1 to allow a real pump.fun launch
LAUNCH_APPROVAL=auto                  # auto (default) launches as soon as the plan is ready; owner waits for /api/admin approve-launch
LAUNCH_DEV_BUY_SOL=0                  # dev buy at creation; the house never sells its coin
PINATA_JWT=                           # for token metadata upload
SITE_URL=https://agent-house.vercel.app

# --- control ---
ADMIN_TOKEN=                          # header x-admin-token for POST /api/admin (approve-launch, halt, resume, reset-world)
TICK_SECRET=                          # external cron calls /api/tick?secret=... to keep the house running unattended
TICK_INTERVAL_MS=45000
AI_PAUSED=0                           # 1 pauses every AI call
